---
/**
 * Wedding dance packages (Embrace, Flow, Unity): price cards, a comparison
 * table, location/travel and "need more lessons" notes.
 *
 * Each package button jumps to the contact form and, if the message is still
 * empty, writes "We are interested in the <package> package" in it.
 * Texts and prices: `packages` in src/i18n/content/wedding-dance.ts.
 */
import Button from './Button.astro';
import { pagePath, type Language } from '../i18n/languages';
import { fillText } from '../i18n/content/common';
import type { WeddingDanceText } from '../i18n/content/wedding-dance';

interface Props {
  language: Language;
  texts: WeddingDanceText['packages'];
  /** Id of the contact section the package buttons point to. */
  contactSectionId: string;
}

const { language, texts, contactSectionId } = Astro.props;

// Prices as numbers for the structured data (e.g. "€1,299" / "€1.299" -> "1299").
const priceNumber = (price: string) => price.replace(/[^0-9]/g, '');
const offersSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: texts.heading,
  description: texts.intro,
  provider: { '@type': 'LocalBusiness', name: 'Tango MJ', url: 'https://www.tangomj.nl/' },
  areaServed: 'Limburg, NL',
  offers: texts.plans.map((plan) => ({
    '@type': 'Offer',
    name: `${plan.name} – ${plan.lessons}`,
    price: priceNumber(plan.price),
    priceCurrency: 'EUR',
  })),
};
---

<!-- ============ Packages: three cards ============ -->
<section id="packages" class="section" aria-labelledby="packages-heading">
  <div class="container">
    <div class="section-intro" data-reveal>
      <span class="eyebrow">{texts.eyebrow}</span>
      <h2 id="packages-heading">{texts.heading}</h2>
      <p>{texts.intro}</p>
    </div>

    <div class="packages" data-reveal-group>
      {
        texts.plans.map((plan) => (
          <article class:list={['package', { 'package--featured': plan.badge }]} data-reveal>
            {plan.badge && <p class="package__badge">{plan.badge}</p>}
            <h3 class="package__name">{plan.name}</h3>
            <p class="package__lessons">{plan.lessons}</p>
            <p class="package__price">{plan.price}</p>
            <p class="package__summary">{plan.summary}</p>

            <div class="package__body">
            <ul class="package__features">
              {plan.features.map((feature) => (
                <li>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                    <path
                      d="M5 12.5l4.2 4.2L19 7"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
            {plan.footnote && <p class="package__footnote">{plan.footnote}</p>}
            </div>

            <Button
              href={`#${contactSectionId}`}
              variant={plan.badge ? 'primary' : 'outline'}
              class="package__button"
              data-package-message={fillText(texts.enquiryMessage, { package: plan.name })}
            >
              {plan.button}
            </Button>
          </article>
        ))
      }
    </div>

    <p class="packages__vat" data-reveal>{texts.vatNote}</p>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(offersSchema)} />
</section>

<!-- ============ Comparison and conditions ============ -->
<section class="section section--tint" aria-labelledby="compare-heading">
  <div class="container">
    <div class="section-intro" data-reveal>
      <h2 id="compare-heading">{texts.comparison.heading}</h2>
    </div>

    <div class="compare" data-reveal>
      <table>
        <thead>
          <tr>
            <th scope="col">{texts.comparison.featureColumn}</th>
            {texts.plans.map((plan) => <th scope="col">{plan.name}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            texts.comparison.rows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {row.values.map((value) => (
                  <td>
                    {value === 'yes' ? (
                      <span class="compare__yes" role="img" aria-label={texts.comparison.included}>
                        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                          <path
                            d="M5 12.5l4.2 4.2L19 7"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>
                    ) : value === 'no' ? (
                      <span class="compare__no" role="img" aria-label={texts.comparison.notIncluded}>
                        –
                      </span>
                    ) : (
                      value
                    )}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="conditions" data-reveal-group>
      <div class="conditions__card" data-reveal>
        <h3>{texts.location.heading}</h3>
        {texts.location.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="conditions__card" data-reveal>
        <h3>{texts.moreLessons.heading}</h3>
        {texts.moreLessons.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <p>
          <a class="conditions__link" href={pagePath('privateLessons', language)}>{texts.moreLessons.link} &rarr;</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Package cards ---------- */
  .packages {
    display: grid;
    gap: var(--gap-md);
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  @media (min-width: 900px) {
    .packages {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .package {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius);
    box-shadow: var(--shadow-rest);
    padding: clamp(26px, 3vw, 36px);
    transition:
      transform 0.5s var(--ease-premium),
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  .package:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-hover);
  }

  /* Unity: the complete package stands out with the burgundy accent */
  .package--featured {
    border: 1.5px solid var(--color-acento);
    box-shadow: var(--shadow-hover);
  }

  .package__badge {
    position: absolute;
    top: 0;
    left: 50%;
    margin: 0;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--color-acento);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  .package__name {
    margin: 0;
    font-size: clamp(24px, 2.6vw, 30px);
    font-weight: var(--weight-heading);
    color: var(--color-principal);
  }

  .package__lessons {
    margin: 4px 0 0;
    font-size: 14px;
    font-weight: 500;
    color: rgba(44, 44, 42, 0.62);
  }

  .package__price {
    margin: 18px 0 0;
    font-size: clamp(34px, 3.6vw, 42px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-texto);
    font-variant-numeric: tabular-nums;
  }

  .package__summary {
    margin: 14px 0 0;
    padding-bottom: 20px;
    border-bottom: var(--border-subtle);
    font-size: 14.5px;
    line-height: 1.6;
    color: rgba(44, 44, 42, 0.72);
  }

  .package__features {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .package__features li {
    display: flex;
    gap: 10px;
    font-size: 14.5px;
    line-height: 1.5;
    color: rgba(44, 44, 42, 0.85);
  }

  .package__features svg {
    flex: none;
    margin-top: 2px;
    color: var(--color-secundario);
  }

  .package--featured .package__features svg {
    color: var(--color-acento);
  }

  .package__footnote {
    margin: 14px 0 0;
    font-size: 12.5px;
    line-height: 1.55;
    color: rgba(44, 44, 42, 0.62);
  }

  /* The list grows, so the buttons line up at the bottom of every card */
  .package__body {
    flex: 1;
    padding-bottom: 26px;
  }

  .package :global(.package__button) {
    width: 100%;
  }

  .packages__vat {
    margin: 20px 0 0;
    text-align: center;
    font-size: 13.5px;
    color: rgba(44, 44, 42, 0.62);
  }

  /* ---------- Comparison table ---------- */
  .compare {
    overflow-x: auto;
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius);
    box-shadow: var(--shadow-rest);
  }

  .compare table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 14.5px;
  }

  .compare th,
  .compare td {
    padding: 14px 18px;
    border-bottom: var(--border-subtle);
    text-align: center;
    vertical-align: middle;
  }

  .compare tbody tr:last-child th,
  .compare tbody tr:last-child td {
    border-bottom: 0;
    font-weight: 600;
    color: var(--color-principal);
  }

  .compare thead th {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-principal);
    background: var(--color-header);
  }

  .compare th[scope='row'],
  .compare thead th:first-child {
    text-align: left;
    font-weight: 500;
    color: var(--color-texto);
  }

  /* Keep the feature names visible while scrolling the table sideways on phones */
  .compare th[scope='row'],
  .compare thead th:first-child {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--color-surface);
  }

  .compare thead th:first-child {
    background: var(--color-header);
  }

  .compare td {
    color: rgba(44, 44, 42, 0.85);
  }

  /* Phones: all three packages side by side, no sideways scrolling */
  @media (max-width: 640px) {
    .compare table {
      min-width: 0;
      table-layout: fixed;
      font-size: 13px;
    }

    .compare th,
    .compare td {
      padding: 11px 6px;
      hyphens: auto;
      overflow-wrap: anywhere;
    }

    .compare th[scope='row'],
    .compare thead th:first-child {
      width: 37%;
      padding-left: 12px;
    }

    /* Package names never break */
    .compare thead th {
      font-size: 13px;
      hyphens: manual;
      overflow-wrap: normal;
    }

    .compare thead th:first-child {
      font-size: 12.5px;
    }

    .compare td {
      font-size: 12px;
    }

    .compare tbody tr:last-child td {
      font-size: 13px;
    }
  }

  .compare__yes {
    display: inline-flex;
    color: var(--color-acento);
  }

  .compare__no {
    color: rgba(44, 44, 42, 0.35);
  }

  /* ---------- Conditions ---------- */
  .conditions {
    display: grid;
    gap: var(--gap-md);
    margin-top: var(--gap-lg);
  }

  @media (min-width: 860px) {
    .conditions {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .conditions__card {
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius);
    box-shadow: var(--shadow-rest);
    padding: clamp(24px, 3vw, 34px);
  }

  .conditions__card h3 {
    margin: 0 0 10px;
    font-size: clamp(18px, 1.8vw, 21px);
    font-weight: var(--weight-heading);
    color: var(--color-principal);
  }

  .conditions__card p {
    margin: 0 0 10px;
    font-size: 14.5px;
    line-height: 1.65;
    color: rgba(44, 44, 42, 0.75);
  }

  .conditions__card p:last-child {
    margin-bottom: 0;
  }

  .conditions__link {
    font-weight: 600;
    color: var(--color-principal);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .conditions__link:hover {
    color: var(--color-acento);
  }

  @media (prefers-reduced-motion: reduce) {
    .package:hover {
      transform: none;
    }
  }
</style>

<script>
  /** A package button pre-fills the contact message (only if the visitor hasn't typed one yet). */
  document.querySelectorAll<HTMLAnchorElement>('[data-package-message]').forEach((button) => {
    button.addEventListener('click', () => {
      const message = document.querySelector<HTMLTextAreaElement>('#cf-message');
      if (message && message.value.trim() === '') {
        message.value = button.dataset.packageMessage ?? '';
      }
    });
  });
</script>
