---
/**
 * YouTube video that only loads after a click ("click to play").
 *
 * Until the visitor clicks, the page shows a still image stored on this
 * website and contacts nobody: no request to YouTube or Google, no cookies.
 * On click the player is loaded from youtube-nocookie.com (YouTube's
 * privacy-enhanced mode) and starts playing. Without JavaScript the image is
 * a plain link to the video on youtube.com.
 *
 * If you add a video, keep the Cookie Policy (src/views/legal/CookiePolicy*.astro) accurate.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Language } from '../i18n/languages';
import { COMMON_TEXT, fillText } from '../i18n/content/common';
import { pagePath } from '../i18n/languages';

interface Props {
  language: Language;
  /** The id in the YouTube URL (youtube.com/watch?v=<id>). */
  videoId: string;
  /** Title of the video, used for the play button and the player. */
  title: string;
  /** Still image shown before playing (a local copy of the video thumbnail). */
  poster: ImageMetadata;
}

const { language, videoId, title, poster } = Astro.props;
const texts = COMMON_TEXT[language].video;
const watchUrl = `https://www.youtube.com/watch?v=${videoId}`;
const embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
const [noticeBeforeLink, noticeAfterLink = ''] = texts.notice.split('{link}');
---

<figure class="video">
  <div class="video__frame" data-video data-embed-url={embedUrl} data-title={title}>
    <a class="video__poster" href={watchUrl} target="_blank" rel="noopener noreferrer" data-video-play>
      <Image src={poster} alt="" widths={[640, 960, 1280]} sizes="(min-width: 900px) 820px, 92vw" loading="lazy" />
      <span class="video__play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="30" height="30" focusable="false">
          <path fill="currentColor" d="M8 5.5v13a1 1 0 0 0 1.52.85l10.4-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5Z" />
        </svg>
      </span>
      <span class="video__sr">{fillText(texts.play, { title })}</span>
    </a>
  </div>
  <figcaption class="video__notice">
    {noticeBeforeLink}<a href={pagePath('cookiePolicy', language)}>{texts.policyLink}</a>{noticeAfterLink}
  </figcaption>
</figure>

<style>
  .video {
    margin: 0;
  }

  .video__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: var(--border-subtle);
    border-radius: var(--radius);
    background: #0b1626;
    box-shadow: var(--shadow-hover);
  }

  .video__poster,
  .video__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video__poster :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-premium), filter 0.4s ease;
  }

  /* Round play button in the brand blue: stays visible on light and warm thumbnails */
  .video__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: clamp(64px, 9vw, 84px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-principal);
    color: #fff;
    box-shadow:
      0 0 0 4px rgba(255, 255, 255, 0.85),
      0 12px 30px rgba(7, 26, 54, 0.35);
    transform: translate(-50%, -50%);
    transition: transform 0.4s var(--ease-premium);
  }

  .video__play svg {
    margin-left: 4px; /* optical centring of the triangle */
  }

  .video__poster:hover :global(img) {
    transform: scale(1.02);
    filter: brightness(0.92);
  }

  .video__poster:hover .video__play {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .video__poster:active .video__play {
    transform: translate(-50%, -50%) scale(0.96);
  }

  .video__poster:focus-visible {
    outline: 3px solid var(--color-detalle);
    outline-offset: -3px;
  }

  .video__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .video__notice {
    margin-top: 12px;
    font-size: 13px;
    line-height: 1.55;
    color: rgba(44, 44, 42, 0.65);
  }

  .video__notice a {
    color: var(--color-principal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .video__poster :global(img),
    .video__play {
      transition: none;
    }
  }
</style>

<script>
  /** Replaces the still image with the YouTube player when the visitor clicks play. */
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((frame) => {
    const playLink = frame.querySelector<HTMLAnchorElement>('[data-video-play]');
    if (!playLink) return;

    playLink.addEventListener('click', (event) => {
      event.preventDefault();
      const player = document.createElement('iframe');
      player.src = frame.dataset.embedUrl ?? '';
      player.title = frame.dataset.title ?? '';
      player.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      player.allowFullscreen = true;
      player.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.replaceChildren(player);
      player.focus();
    });
  });
</script>
