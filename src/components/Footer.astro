---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo_web_tr.png';

interface Props {
  siteName: string;
}

const { siteName } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/wedding-dance', label: 'Wedding Dance' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/legal-notice', label: 'Legal Notice' },
];

const socialLinks = [
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/tangomj.experience/',
    path: 'M13.5 21v-7.5h2.53l.38-2.94H13.5V8.68c0-.85.24-1.43 1.46-1.43h1.56V4.62c-.27-.04-1.2-.12-2.28-.12-2.26 0-3.8 1.38-3.8 3.9v2.17H7.9v2.94h2.53V21z',
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/tango_mj/',
    path: 'M12 2.2c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.42.56.22.96.48 1.38.9.42.42.68.82.9 1.38.17.42.37 1.06.42 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.42 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.17-1.06.37-2.23.42-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.42a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.17-.42-.37-1.06-.42-2.23C2.21 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85c.05-1.17.25-1.8.42-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.17 1.06-.37 2.23-.42C8.42 2.21 8.8 2.2 12 2.2Zm0 1.8c-3.15 0-3.5.01-4.74.07-.9.04-1.38.19-1.7.32-.43.16-.74.36-1.06.68-.32.32-.52.63-.68 1.06-.13.32-.28.8-.32 1.7-.06 1.24-.07 1.6-.07 4.74s.01 3.5.07 4.74c.04.9.19 1.38.32 1.7.16.43.36.74.68 1.06.32.32.63.52 1.06.68.32.13.8.28 1.7.32 1.24.06 1.6.07 4.74.07s3.5-.01 4.74-.07c.9-.04 1.38-.19 1.7-.32.43-.16.74-.36 1.06-.68.32-.32.52-.63.68-1.06.13-.32.28-.8.32-1.7.06-1.24.07-1.6.07-4.74s-.01-3.5-.07-4.74c-.04-.9-.19-1.38-.32-1.7a2.85 2.85 0 0 0-.68-1.06 2.85 2.85 0 0 0-1.06-.68c-.32-.13-.8-.28-1.7-.32C15.5 4.01 15.15 4 12 4Zm0 3.06a4.94 4.94 0 1 1 0 9.88 4.94 4.94 0 0 1 0-9.88Zm0 1.8a3.14 3.14 0 1 0 0 6.28 3.14 3.14 0 0 0 0-6.28Zm5.14-3.24a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z',
  },
  {
    label: 'TikTok',
    href: 'https://www.tiktok.com/@tango.mj',
    path: 'M16.6 5.82a4.28 4.28 0 0 1-1.06-2.82h-3.02v11.67a2.6 2.6 0 0 1-2.6 2.5 2.6 2.6 0 1 1 .8-5.08V8.98a5.62 5.62 0 0 0-.8-.06 5.66 5.66 0 1 0 5.66 5.66V8.9a7.26 7.26 0 0 0 4.24 1.36V7.24a4.28 4.28 0 0 1-3.22-1.42Z',
  },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <a href="/" class="site-footer__logo" aria-label={`${siteName} — home`}>
      <Image
        src={logo}
        alt={siteName}
        class="site-footer__logo-img"
        widths={[180, 360]}
        sizes="140px"
        loading="lazy"
      />
    </a>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="site-footer__social">
      {
        socialLinks.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${siteName} on ${social.label}`}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path fill="currentColor" d={social.path} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="site-footer__copy">&copy; {year} {siteName}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--color-header);
    border-top: var(--border-subtle);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: clamp(32px, 5vw, 48px);
  }

  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    flex: none;
  }

  .site-footer__logo-img {
    display: block;
    width: auto;
    height: 40px;
  }

  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__nav a {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-texto);
  }

  .site-footer__nav a:hover {
    color: var(--color-principal);
  }

  .site-footer__social {
    display: flex;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(7, 58, 124, 0.24);
    border-radius: var(--radius-sm);
    color: var(--color-principal);
    transition:
      color 0.3s ease,
      border-color 0.3s ease,
      background-color 0.3s ease,
      transform 0.3s var(--ease-premium);
  }

  .site-footer__social a:hover {
    color: var(--color-acento);
    border-color: var(--color-acento);
    background: rgba(122, 31, 43, 0.05);
    transform: translateY(-3px) scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__social a:hover {
      transform: none;
    }
  }

  .site-footer__social svg {
    display: block;
  }

  .site-footer__copy {
    margin: 0;
    font-size: 13px;
    color: rgba(44, 44, 42, 0.7);
    width: 100%;
  }
</style>
