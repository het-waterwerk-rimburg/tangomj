---
interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  href?: string;
  cta?: string;
}

const { title, description, image, imageAlt = '', href, cta } = Astro.props;
const linked = Boolean(href);
---

<article class:list={['card', { 'card--linked': linked }]}>
  {
    image && (
      <div class="card__media">
        <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
      </div>
    )
  }

  <div class="card__body">
    <h3 class="card__title">
      {
        href ? (
          <a href={href} class="card__link">
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>

    {description && <p class="card__text">{description}</p>}

    {
      cta && href && (
        <span class="card__cta" aria-hidden="true">
          {cta} &rarr;
        </span>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius);
    box-shadow: var(--shadow-rest);
    overflow: hidden;
    transition:
      transform 0.5s var(--ease-premium),
      border-color 0.4s ease,
      box-shadow 0.4s ease,
      background-color 0.4s ease;
  }

  .card:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--color-principal) 45%, transparent);
    box-shadow: var(--shadow-hover);
  }

  .card--linked:hover {
    transform: translateY(-8px);
    border-color: var(--color-acento);
  }

  .card__media {
    aspect-ratio: 16 / 10;
    background: var(--color-bg);
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(24px, 3vw, 34px) clamp(22px, 2.4vw, 30px);
  }

  .card__title {
    margin: 0;
  }

  .card__link {
    color: var(--color-principal);
  }

  /* Make the whole card clickable while keeping the link as the a11y target */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__link:hover {
    color: var(--color-acento);
  }

  .card__text {
    margin: 0;
    color: rgba(44, 44, 42, 0.75);
    font-size: 15px;
  }

  .card__cta {
    margin-top: 4px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-secundario);
  }

  @media (max-width: 420px) {
    .card {
      border-radius: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .card--linked:hover {
      transform: none;
    }
  }
</style>
