---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import logo from '../assets/images/logo_web_tr.png';
import { pagePath, type Language, type PageId } from '../i18n/languages';
import { COMMON_TEXT, fillText } from '../i18n/content/common';

interface Props {
  siteName: string;
  language: Language;
  /** Current page, to highlight its menu link and to link the other languages. */
  page?: PageId;
}

const { siteName, language, page } = Astro.props;
const texts = COMMON_TEXT[language].navigation;

const navLinks: { page: PageId; label: string }[] = [
  { page: 'home', label: texts.home },
  { page: 'weddingDance', label: texts.weddingDance },
  { page: 'privateLessons', label: texts.privateLessons },
  { page: 'about', label: texts.about },
  { page: 'contact', label: texts.contact },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={pagePath('home', language)} class="site-header__logo" aria-label={fillText(texts.homeLink, { site: siteName })}>
      <Image
        src={logo}
        alt={siteName}
        class="site-header__logo-img"
        widths={[180, 360]}
        sizes="120px"
        loading="eager"
      />
    </a>

    <div class="site-header__tools">
      <LanguageSwitcher language={language} page={page} />

      <button
        type="button"
        class="site-header__toggle"
        aria-label={texts.openMenu}
        aria-expanded="false"
        aria-controls="primary-nav"
        data-nav-toggle
        data-label-open={texts.openMenu}
        data-label-close={texts.closeMenu}
      >
        <span class="site-header__toggle-bar" aria-hidden="true"></span>
        <span class="site-header__toggle-bar" aria-hidden="true"></span>
        <span class="site-header__toggle-bar" aria-hidden="true"></span>
      </button>
    </div>

    <nav id="primary-nav" class="site-header__nav" aria-label={texts.primaryLabel} data-nav>
      <ul class="site-header__list">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={pagePath(link.page, language)}
                class="site-header__link"
                aria-current={link.page === page ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href={pagePath('home', language, 'contact')} variant="primary" class="site-header__cta">
        {texts.bookLesson}
      </Button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: var(--border-subtle);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    flex: none;
  }

  .site-header__logo-img {
    display: block;
    width: auto;
    height: 30px;
  }

  @media (min-width: 640px) {
    .site-header__logo-img {
      height: 34px;
    }
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 36px);
    margin-left: auto;
  }

  /* Language button (+ menu button on small screens). After the menu on wide
     screens; next to the menu button, always visible, on small screens. */
  .site-header__tools {
    display: flex;
    align-items: center;
    gap: 10px;
    order: 3;
  }

  .site-header__list {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.4vw, 28px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__link {
    display: inline-block;
    white-space: nowrap;
    padding: 6px 2px;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-texto);
    border-bottom: 2px solid transparent;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .site-header__link:hover {
    color: var(--color-principal);
    border-bottom-color: rgba(246, 180, 14, 0.55);
  }

  .site-header__link[aria-current='page'] {
    color: var(--color-principal);
    border-bottom-color: var(--color-detalle);
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0 10px;
    background: transparent;
    border: 1px solid rgba(7, 58, 124, 0.16);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .site-header__toggle-bar {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-principal);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Below this width the five links, the button and the language switcher no
     longer fit on one row (German labels are the longest): use the menu button.
     Keep in sync with the matchMedia query in the script below. */
  @media (max-width: 1120px) {
    .site-header__toggle {
      display: flex;
    }

    .site-header__nav {
      position: absolute;
      inset: 100% 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      padding: 16px var(--section-padding-x) 24px;
      background: var(--color-bg);
      border-bottom: var(--border-subtle);
      box-shadow: var(--shadow-hover);

      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
    }

    .site-header__nav[data-open='true'] {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
    }

    .site-header__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .site-header__link {
      padding: 12px 0;
      border-bottom: 1px solid rgba(7, 58, 124, 0.1);
    }

    .site-header__link[aria-current='page'] {
      border-bottom-color: rgba(7, 58, 124, 0.1);
    }

    .site-header__nav :global(.site-header__cta) {
      margin-top: 12px;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__nav,
    .site-header__toggle-bar {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (toggle && nav) {
    const mq = window.matchMedia('(max-width: 1120px)');

    const setOpen = (open: boolean) => {
      nav.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute(
        'aria-label',
        (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? ''
      );
    };

    setOpen(false);

    toggle.addEventListener('click', () => {
      setOpen(nav.dataset.open !== 'true');
    });

    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.dataset.open === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    mq.addEventListener('change', (event) => {
      if (!event.matches) setOpen(false);
    });
  }
</script>
