---
/**
 * One blog article, in any language. The text is the Markdown file in
 * src/content/blog/<language>/<slug>.md; this view adds the page frame,
 * date, links to the translations, BlogPosting data and a call to action.
 */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import YouTubeVideo from '../components/YouTubeVideo.astro';
import { LANGUAGE_DETAILS, pagePath, type Language } from '../i18n/languages';
import { PAGES_TEXT } from '../i18n/content/pages';
import { getPostTranslations, splitPostId, type BlogPost } from '../i18n/blog';

interface Props {
  language: Language;
  post: BlogPost;
}

const { language, post } = Astro.props;
const texts = PAGES_TEXT[language].blog;
const { Content } = await render(post);
const translations = await getPostTranslations(splitPostId(post).slug);
const isoDate = post.data.date.toISOString().slice(0, 10);
const readableDate = new Intl.DateTimeFormat(texts.dateLocale, { dateStyle: 'long' }).format(post.data.date);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: isoDate,
  inLanguage: LANGUAGE_DETAILS[language].htmlLang,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
  author: [
    { '@type': 'Person', name: 'Maddalena Mol', url: 'https://www.linkedin.com/in/maddalena-mol-36410527/' },
    { '@type': 'Person', name: 'Joel Correa', url: 'https://www.linkedin.com/in/joel-correa-26254425/' },
  ],
  publisher: { '@type': 'Organization', name: 'Tango MJ', url: 'https://www.tangomj.nl/' },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  language={language}
  alternatePaths={translations}
  ogType="article"
>
  <article class="section">
    <div class="container article">
      <header class="article__head">
        <p class="article__back">
          <a href={pagePath('blog', language)}>&larr; {texts.backToBlog}</a>
        </p>
        <h1 data-reveal>{post.data.title}</h1>
        <p class="article__date" data-reveal>
          {texts.publishedOn} <time datetime={isoDate}>{readableDate}</time>
        </p>
      </header>

      <div class="article__body" data-reveal>
        <Content />
      </div>

      {
        post.data.video && (
          <div class="article__video" data-reveal>
            <YouTubeVideo
              language={language}
              videoId={post.data.video.id}
              title={post.data.video.title}
              poster={post.data.video.poster}
            />
          </div>
        )
      }
    </div>
  </article>

  <CTA
    heading={texts.callToAction.heading}
    description={texts.callToAction.description}
    button={{ href: pagePath('home', language, 'contact'), label: texts.callToAction.button }}
  />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
</BaseLayout>

<style>
  .article {
    max-width: 720px;
  }

  .article__head {
    margin-bottom: clamp(32px, 5vw, 48px);
  }

  .article__back {
    margin: 0 0 20px;
    font-size: 14px;
    font-weight: 600;
  }

  .article__back a {
    color: var(--color-secundario);
  }

  .article__back a:hover {
    color: var(--color-acento);
  }

  .article__head h1 {
    margin: 0;
    font-size: clamp(30px, 4.4vw, 46px);
    line-height: 1.15;
    text-wrap: balance;
  }

  .article__date {
    margin: 16px 0 0;
    font-size: 14px;
    color: rgba(44, 44, 42, 0.62);
  }

  /* ---------- Article text (comes from Markdown, hence :global) ---------- */
  .article__body {
    font-size: clamp(16.5px, 1.6vw, 18px);
    line-height: 1.8;
    color: rgba(44, 44, 42, 0.88);
  }

  .article__body :global(p) {
    margin: 0 0 1.15em;
  }

  /* Section headings inside an article: smaller than page headings, and
     without the yellow accent line so the title keeps the only one. */
  .article__body :global(h2) {
    margin: 1.9em 0 0.6em;
    font-size: clamp(22px, 2.6vw, 27px);
    line-height: 1.25;
    text-wrap: balance;
  }

  .article__body :global(h2::after) {
    display: none;
  }

  .article__video {
    margin-top: clamp(28px, 4vw, 40px);
  }

  .article__body :global(a) {
    color: var(--color-principal);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-detalle) 80%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .article__body :global(a:hover) {
    color: var(--color-acento);
  }

  .article__body :global(strong) {
    color: var(--color-principal);
    font-weight: 600;
  }

  /* Quotes from workshop participants */
  .article__body :global(blockquote) {
    margin: 0.4em 0 1.2em;
    padding: 4px 0 4px 22px;
    border-left: 1px solid var(--color-detalle);
    font-size: 1.08em;
    font-style: italic;
    color: var(--color-principal);
  }

  .article__body :global(blockquote p) {
    margin: 0;
  }

  /* The slogan: the moment the article turns on */
  .article__body :global(.article-slogan) {
    margin: 1.6em 0;
    padding: clamp(24px, 4vw, 36px);
    border-radius: var(--radius);
    background: var(--color-header);
    text-align: center;
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-acento);
  }

  .article__body :global(.article-slogan span) {
    display: block;
    margin-top: 10px;
    font-size: 15px;
    font-weight: 500;
    color: rgba(44, 44, 42, 0.7);
  }
</style>
