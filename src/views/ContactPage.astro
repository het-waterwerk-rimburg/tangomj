---
/**
 * Contact page, in any language. Route files only choose the language.
 * Texts: src/i18n/content/pages.ts (contact) and common.ts (form, details).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import type { Language } from '../i18n/languages';
import { PAGES_TEXT } from '../i18n/content/pages';
import { COMMON_TEXT } from '../i18n/content/common';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const texts = PAGES_TEXT[language].contact;
const contactDetails = COMMON_TEXT[language].contactDetails;
---

<BaseLayout
  title={texts.meta.title}
  description={texts.meta.description}
  language={language}
  page="contact"
>
  <section class="section">
    <div class="container contact-layout">
      <div class="contact-layout__intro">
        <span class="eyebrow">{texts.eyebrow}</span>
        <h1>{texts.heading}</h1>
        <p>{texts.intro}</p>

        <ul class="contact-layout__details">
          <li>
            <strong>{contactDetails.email}</strong>
            <a href="mailto:info@tangomj.nl">info@tangomj.nl</a>
          </li>
          <li>
            <strong>{contactDetails.whatsapp}</strong>
            <a
              href="https://wa.me/31621710803"
              target="_blank"
              rel="noopener noreferrer">+31 6 21710803</a
            >
          </li>
          <li><strong>{contactDetails.area}</strong> {contactDetails.areaValue}</li>
        </ul>
      </div>

      <div class="contact-layout__form surface-card">
        <ContactForm language={language} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-layout {
    display: grid;
    gap: clamp(32px, 6vw, 64px);
  }

  @media (min-width: 860px) {
    .contact-layout {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .contact-layout__details {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
    color: rgba(44, 44, 42, 0.8);
  }
</style>
