---
/**
 * Buenos Aires Tango Immersion 2027: an expression of interest for a small-group
 * trip (not a booking), in any language. Not linked from the menu yet.
 * Route files only choose the language. Texts: src/i18n/content/buenos-aires-2027.ts.
 * Photos come from the trip PDF in web-info/, except four from Wikimedia Commons.
 * pena.jpg was chosen by the owner from a web image search: source and licence unknown
 * (CC BY-SA: author and licence must stay visible, see PHOTO_CREDITS).
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import ContactForm from '../components/ContactForm.astro';
import heroImage from '../assets/images/buenos-aires/obelisco.jpg';
import laBocaImage from '../assets/images/buenos-aires/la-boca.jpg';
import milongaImage from '../assets/images/buenos-aires/milonga.jpg';
import asadoImage from '../assets/images/buenos-aires/asado.jpg';
import tigreImage from '../assets/images/buenos-aires/tigre.jpg';
import tortoniImage from '../assets/images/buenos-aires/cafe-tortoni.jpg';
import aguasImage from '../assets/images/buenos-aires/aguas-corrientes.jpg';
import terraceImage from '../assets/images/buenos-aires/guesthouse-terrace.jpg';
import maddieJoelImage from '../assets/images/buenos-aires/maddie-joel.jpg';
import tangoShowImage from '../assets/images/buenos-aires/tango-show.jpg';
import penaImage from '../assets/images/buenos-aires/pena.jpg';
import sanTelmoImage from '../assets/images/buenos-aires/san-telmo-market.jpg';
import recoletaImage from '../assets/images/buenos-aires/recoleta.jpg';
import glorietaImage from '../assets/images/buenos-aires/glorieta.jpg';
import { type Language } from '../i18n/languages';
import { BUENOS_AIRES_TEXT } from '../i18n/content/buenos-aires-2027';
import { COMMON_TEXT } from '../i18n/content/common';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const texts = BUENOS_AIRES_TEXT[language];
const contactDetails = COMMON_TEXT[language].contactDetails;
const culturePhotos = {
  asado: asadoImage,
  tangoShow: tangoShowImage,
  pena: penaImage,
  sanTelmo: sanTelmoImage,
  recoleta: recoletaImage,
  tigre: tigreImage,
  tortoni: tortoniImage,
  aguas: aguasImage,
};

/** Wikimedia Commons photos: shown under the photo, as their licences require. */
const PHOTO_CREDITS: Record<string, { author: string; license: string; licenseUrl: string; source: string }> = {
  tangoShow: {
    author: 'Dennis G. Jarvis',
    license: 'CC BY-SA 2.0',
    licenseUrl: 'https://creativecommons.org/licenses/by-sa/2.0/',
    source: 'https://commons.wikimedia.org/wiki/File:Argentina-02195_-_Tango_Show_(49024279941).jpg',
  },
  sanTelmo: {
    author: 'Liam Quinn',
    license: 'CC BY-SA 2.0',
    licenseUrl: 'https://creativecommons.org/licenses/by-sa/2.0/',
    source: 'https://commons.wikimedia.org/wiki/File:San_Telmo_Market_(5423566026).jpg',
  },
  recoleta: {
    author: 'Sking',
    license: 'CC BY-SA 3.0',
    licenseUrl: 'https://creativecommons.org/licenses/by-sa/3.0/',
    source: 'https://commons.wikimedia.org/wiki/File:Cementerio_de_la_Recoleta.jpg',
  },
  glorieta: {
    author: 'GCBA',
    license: 'CC BY-SA 2.5',
    licenseUrl: 'https://creativecommons.org/licenses/by-sa/2.5/',
    source: 'https://commons.wikimedia.org/wiki/File:Glorieta_de_Barrancas_de_Belgrano.jpg',
  },
};
// 12 places, the first 8 filled: the group goes ahead from 8 students
/** The trip brochure (web-info/Buenos_Aires_Tango_Immersion_2027_1.pdf), in English only */
const BROCHURE_PDF = '/downloads/buenos-aires-tango-immersion-2027.pdf';
const groupSeats = Array.from({ length: 12 }, (_, index) => index < 8);
---

<BaseLayout
  title={texts.meta.title}
  description={texts.meta.description}
  language={language}
  page="buenosAires2027"
>
  <Hero
    image={heroImage}
    imageAlt={texts.hero.imageAlt}
    eyebrow={texts.hero.eyebrow}
    heading={texts.hero.heading}
    description={texts.hero.description}
    primaryCta={{ href: '#interest', label: texts.hero.primaryButton }}
    secondaryCta={{ href: '#included', label: texts.hero.secondaryButton }}
    note={texts.hero.note}
  />

  <!-- ============ Key facts ============ -->
  <section class="section section--tint trip-facts-section" aria-label={texts.meta.title}>
    <div class="container">
      <dl class="trip-facts" data-reveal-group>
        {
          texts.facts.map((fact) => (
            <div class="trip-facts__item" data-reveal>
              <dt>{fact.title}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ============ The idea ============ -->
  <section class="section">
    <div class="container split">
      <div data-reveal="left">
        <span class="eyebrow">{texts.idea.eyebrow}</span>
        <h2>{texts.idea.heading}</h2>
        <p class="lead">{texts.idea.lead}</p>
        {texts.idea.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <ul class="tags">
          {texts.idea.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
      <figure class="photo" data-reveal="right">
        <Image src={laBocaImage} alt={texts.idea.imageAlt} widths={[640, 1000, 1600]} sizes="(min-width: 860px) 50vw, 100vw" />
        <figcaption>{texts.idea.caption}</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ A day in Buenos Aires ============ -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-intro" data-reveal>
        <span class="eyebrow">{texts.day.eyebrow}</span>
        <h2>{texts.day.heading}</h2>
        <p>{texts.day.intro}</p>
      </div>
      <ol class="day" data-reveal-group>
        {
          texts.day.moments.map((moment) => (
            <li class="day__moment" data-reveal>
              <span class="day__time">{moment.time}</span>
              <span class="day__text">{moment.text}</span>
            </li>
          ))
        }
      </ol>
      <p class="note" data-reveal>{texts.day.note}</p>
    </div>
  </section>

  <!-- ============ Tango ============ -->
  <section class="section">
    <div class="container">
      <div class="section-intro" data-reveal>
        <span class="eyebrow">{texts.tango.eyebrow}</span>
        <h2>{texts.tango.heading}</h2>
        <p>{texts.tango.lead}</p>
      </div>

      <div class="split">
        <div data-reveal="left">
          <h3 class="list-title">{texts.tango.listTitle}</h3>
          <ul class="dash-list">
            {texts.tango.items.map((item) => <li><strong>{item.strong}</strong>{item.rest && `, ${item.rest}`}</li>)}
          </ul>
        </div>
        <div class="photo-stack" data-reveal="right">
          <figure class="photo">
            <Image src={milongaImage} alt={texts.tango.imageAlt} widths={[640, 1000, 1372]} sizes="(min-width: 860px) 50vw, 100vw" />
            <figcaption>{texts.tango.caption}</figcaption>
          </figure>
          <figure class="photo">
            <Image src={glorietaImage} alt={texts.tango.glorietaAlt} widths={[640, 700]} sizes="(min-width: 860px) 50vw, 100vw" />
            <figcaption>
              {texts.tango.glorietaCaption}
              <span class="credit">
                <a href={PHOTO_CREDITS.glorieta.source} target="_blank" rel="noopener noreferrer">{PHOTO_CREDITS.glorieta.author}</a>,
                <a href={PHOTO_CREDITS.glorieta.licenseUrl} target="_blank" rel="noopener noreferrer">{PHOTO_CREDITS.glorieta.license}</a>
              </span>
            </figcaption>
          </figure>
        </div>
      </div>

      <aside class="callout callout--burgundy" data-reveal>
        <span class="callout__title">{texts.tango.goodToKnowTitle}</span>
        <p>{texts.tango.goodToKnow}</p>
      </aside>

      <div class="promises" data-reveal-group>
        {
          texts.tango.promises.map((promise) => (
            <article class="promises__item" data-reveal>
              <h3>{promise.title}</h3>
              <p>{promise.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ Culture, food and the city ============ -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-intro" data-reveal>
        <span class="eyebrow">{texts.culture.eyebrow}</span>
        <h2>{texts.culture.heading}</h2>
      </div>

      <div class="culture" data-reveal-group>
        {
          texts.culture.groups.map((group) => (
            <div class="culture__group" data-reveal>
              <h3 class="list-title">{group.title}</h3>
              <ul class="dash-list">
                {group.items.map((item) => <li><strong>{item.strong}</strong>{item.rest && `, ${item.rest}`}</li>)}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="gallery" data-reveal-group>
        {
          texts.culture.photos.map((photo) => (
            <figure class="photo" data-reveal>
              <Image
                src={culturePhotos[photo.key as keyof typeof culturePhotos]}
                alt={photo.alt}
                widths={[480, 800]}
                sizes="(min-width: 960px) 25vw, (min-width: 560px) 50vw, 100vw"
              />
              <figcaption>
                {photo.caption}
                {PHOTO_CREDITS[photo.key] && (
                  <span class="credit">
                    <a href={PHOTO_CREDITS[photo.key].source} target="_blank" rel="noopener noreferrer">{PHOTO_CREDITS[photo.key].author}</a>,{' '}
                    <a href={PHOTO_CREDITS[photo.key].licenseUrl} target="_blank" rel="noopener noreferrer">{PHOTO_CREDITS[photo.key].license}</a>
                  </span>
                )}
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="note" data-reveal>{texts.culture.note}</p>
    </div>
  </section>

  <!-- ============ Accommodation ============ -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div data-reveal="left">
          <span class="eyebrow">{texts.stay.eyebrow}</span>
          <h2>{texts.stay.heading}</h2>
          <p>{texts.stay.text}</p>
          <h3 class="list-title">{texts.stay.listTitle}</h3>
          <ul class="dash-list">
            {texts.stay.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <figure class="photo" data-reveal="right">
          <Image src={terraceImage} alt={texts.stay.imageAlt} widths={[640, 1000, 1200]} sizes="(min-width: 860px) 50vw, 100vw" />
          <figcaption>{texts.stay.caption}</figcaption>
        </figure>
      </div>
      <aside class="callout callout--cream" data-reveal>
        <p>{texts.stay.option}</p>
      </aside>
    </div>
  </section>

  <!-- ============ Free time ============ -->
  <section class="section section--tint">
    <div class="container narrow" data-reveal>
      <span class="eyebrow">{texts.free.eyebrow}</span>
      <h2>{texts.free.heading}</h2>
      <p>{texts.free.text}</p>
      <ul class="dash-list dash-list--columns">
        {texts.free.items.map((item) => <li>{item}</li>)}
      </ul>
      {texts.free.extras.map((extra) => <p>{extra}</p>)}
    </div>
  </section>

  <!-- ============ What's included ============ -->
  <section id="included" class="section">
    <div class="container">
      <div class="section-intro" data-reveal>
        <span class="eyebrow">{texts.included.eyebrow}</span>
        <h2>{texts.included.heading}</h2>
      </div>

      <div class="included">
        <div class="included__card surface-card" data-reveal="left">
          <h3 class="list-title">{texts.included.includedTitle}</h3>
          <ul class="check-list">
            {texts.included.includedItems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="included__side" data-reveal="right">
          <div class="surface-card">
            <h3 class="list-title">{texts.included.excludedTitle}</h3>
            <ul class="check-list check-list--no">
              {texts.included.excludedItems.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <aside class="callout callout--gold">
            <span class="callout__title">{texts.included.flightsTitle}</span>
            <p>{texts.included.flightsText}</p>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Price and group size ============ -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-intro" data-reveal>
        <span class="eyebrow">{texts.price.eyebrow}</span>
        <h2>{texts.price.heading}</h2>
      </div>
      <div class="price">
        <div class="price__card" data-reveal="left">
          <span class="price__label">{texts.price.label}</span>
          <span class="price__amount">{texts.price.amount}</span>
          <span class="price__unit">{texts.price.unit}</span>
          <span class="price__flights">{texts.price.flights}</span>
        </div>
        <div class="price__info" data-reveal="right">
          <p>{texts.price.text}</p>
          <div class="group surface-card">
            <span class="group__number">8–12</span>
            <div>
              <span class="group__label">{texts.price.groupLabel}</span>
              <span class="group__seats" aria-hidden="true">
                {groupSeats.map((filled) => <span class:list={['group__seat', { 'group__seat--filled': filled }]} />)}
              </span>
            </div>
          </div>
          <p class="note">{texts.price.groupNote}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Why we're asking now ============ -->
  <section class="section">
    <div class="container">
      <div class="ask" data-reveal>
        <span class="eyebrow ask__eyebrow">{texts.ask.eyebrow}</span>
        <h2>{texts.ask.heading}</h2>
        <p>{texts.ask.text}</p>
        <p><strong>{texts.ask.strong}</strong> {texts.ask.after}</p>
        <div class="ask__actions">
          <Button href="#interest" variant="primary">{texts.hero.primaryButton}</Button>
          <Button href={BROCHURE_PDF} variant="ghost" download>{texts.interest.brochureButton}</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Expression of interest ============ -->
  <section id="interest" class="section section--tint">
    <div class="container interest">
      <div class="interest__intro" data-reveal="left">
        <figure class="interest__photo">
          <Image src={maddieJoelImage} alt={texts.interest.imageAlt} widths={[400, 700]} sizes="(min-width: 860px) 280px, 60vw" />
        </figure>
        <span class="eyebrow">{texts.interest.eyebrow}</span>
        <h2>{texts.interest.heading}</h2>
        <p>{texts.interest.text}</p>
        <p class="interest__signature">{texts.interest.signature}</p>
        <p>
          <Button href={BROCHURE_PDF} variant="outline" download>{texts.interest.brochureButton}</Button>
        </p>
        <ul class="interest__details">
          <li><strong>{contactDetails.email}</strong> <a href="mailto:info@tangomj.nl">info@tangomj.nl</a></li>
          <li>
            <strong>{contactDetails.whatsapp}</strong>{' '}
            <a href="https://wa.me/31621710803" target="_blank" rel="noopener noreferrer">+31 6 21710803</a>
          </li>
        </ul>
      </div>

      <div class="surface-card" data-reveal="right">
        <p class="interest__form-intro">{texts.interest.formIntro}</p>
        <ContactForm language={language} selectedTopic="Other" defaultMessage={texts.interest.defaultMessage} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Key facts ---------- */
  .trip-facts-section {
    padding-block: clamp(32px, 5vw, 56px);
  }

  .trip-facts {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, 1fr);
    margin: 0 auto;
    max-width: 1040px;
  }

  @media (min-width: 900px) {
    .trip-facts {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .trip-facts__item {
    padding: clamp(16px, 2.4vw, 22px);
    background: var(--color-bg);
    border-radius: var(--radius-sm);
    /* Gold top edge drawn inside, like the featured price card on the classes page */
    box-shadow: inset 0 3px 0 var(--color-detalle);
  }

  .trip-facts__item dt {
    font-size: 12px;
    font-weight: var(--weight-label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-secundario);
  }

  .trip-facts__item dd {
    margin: 6px 0 0;
    font-size: clamp(17px, 1.8vw, 20px);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-principal);
  }

  /* ---------- Text + photo ---------- */
  .split {
    display: grid;
    gap: clamp(32px, 6vw, 64px);
  }

  @media (min-width: 860px) {
    .split {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }

  .lead {
    font-size: clamp(17px, 1.7vw, 19px);
    font-weight: 500;
    color: var(--color-principal);
  }

  .photo {
    margin: 0;
  }

  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow-rest);
  }

  .photo figcaption {
    margin-top: 10px;
    font-size: 13px;
    color: rgba(44, 44, 42, 0.6);
  }

  .photo-stack {
    display: grid;
    gap: var(--gap-md);
  }

  /* Author and licence of a Wikimedia Commons photo */
  .credit {
    display: block;
    margin-top: 2px;
    font-size: 11.5px;
    color: rgba(44, 44, 42, 0.55);
  }

  .credit a {
    color: inherit;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
  }

  .tags li {
    padding: 6px 14px;
    border: 1px solid rgba(7, 58, 124, 0.25);
    border-radius: 999px;
    background: var(--color-surface);
    font-size: 12px;
    font-weight: var(--weight-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-principal);
  }

  .note {
    max-width: 760px;
    margin: 24px auto 0;
    font-size: 14.5px;
    font-style: italic;
    text-align: center;
    color: rgba(44, 44, 42, 0.65);
  }

  /* ---------- Lists ---------- */
  .list-title {
    margin: 0 0 14px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-acento);
  }

  .dash-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .dash-list li {
    position: relative;
    padding-left: 24px;
    line-height: 1.55;
  }

  /* Gold dash, as in the trip brochure */
  .dash-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 12px;
    height: 3px;
    border-radius: 999px;
    background: var(--color-detalle);
  }

  .dash-list strong {
    color: var(--color-principal);
  }

  @media (min-width: 640px) {
    .dash-list--columns {
      grid-template-columns: 1fr 1fr;
      margin: 20px 0;
    }
  }

  /* ---------- A day in Buenos Aires ---------- */
  .day {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 860px;
    background: var(--color-bg);
    border: var(--border-subtle);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .day__moment {
    display: grid;
    gap: 4px;
    padding: 18px clamp(18px, 3vw, 28px);
  }

  .day__moment + .day__moment {
    border-top: var(--border-subtle);
  }

  @media (min-width: 640px) {
    .day__moment {
      grid-template-columns: 160px 1fr;
      align-items: center;
    }
  }

  .day__time {
    font-weight: 700;
    color: var(--color-principal);
  }

  /* ---------- Callouts ---------- */
  .callout {
    margin-top: clamp(32px, 5vw, 48px);
    padding: clamp(20px, 3vw, 28px);
    border-radius: var(--radius-sm);
  }

  .callout p {
    margin: 0;
  }

  .callout__title {
    display: block;
    margin-bottom: 8px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .callout--burgundy {
    background: var(--color-acento);
    color: #fff;
  }

  .callout--burgundy .callout__title {
    color: var(--color-detalle);
  }

  .callout--cream {
    background: var(--color-header);
    border: 1px solid rgba(122, 31, 43, 0.25);
  }

  .callout--gold {
    margin-top: var(--gap-md);
    background: var(--color-surface);
    border: var(--border-subtle);
    box-shadow: inset 0 3px 0 var(--color-detalle);
  }

  .callout--gold .callout__title {
    color: var(--color-principal);
  }

  /* ---------- Promises ---------- */
  .promises {
    display: grid;
    gap: var(--gap-md);
    margin-top: var(--gap-md);
  }

  @media (min-width: 860px) {
    .promises {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .promises__item {
    padding: clamp(20px, 3vw, 28px);
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius);
    box-shadow: inset 0 3px 0 var(--color-secundario), var(--shadow-rest);
    transition:
      transform 0.5s var(--ease-premium),
      box-shadow 0.4s ease;
  }

  .promises__item:hover {
    transform: translateY(-6px);
    box-shadow: inset 0 3px 0 var(--color-secundario), var(--shadow-hover);
  }

  .promises__item h3 {
    margin: 0 0 8px;
    font-weight: var(--weight-heading);
  }

  .promises__item p {
    margin: 0;
    font-size: 15px;
    color: rgba(44, 44, 42, 0.78);
  }

  /* ---------- Culture ---------- */
  .culture {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
  }

  @media (min-width: 860px) {
    .culture {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .gallery {
    display: grid;
    gap: var(--gap-md);
    grid-template-columns: 1fr;
    margin-top: clamp(40px, 6vw, 64px);
  }

  @media (min-width: 560px) {
    .gallery {
