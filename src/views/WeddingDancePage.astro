---
/**
 * Wedding Dance page, in any language ("Openingsdans" / "Hochzeitstanz").
 * Route files only choose the language. Texts: src/i18n/content/wedding-dance.ts.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import CTA from '../components/CTA.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactForm from '../components/ContactForm.astro';
import heroImage from '../assets/images/wedding-hero.jpg';
import maddiePhoto from '../assets/images/maddie.png';
import joelPhoto from '../assets/images/dj2.webp';
import type { Language } from '../i18n/languages';
import { WEDDING_DANCE_TEXT } from '../i18n/content/wedding-dance';
import { COMMON_TEXT } from '../i18n/content/common';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const texts = WEDDING_DANCE_TEXT[language];
const contactDetails = COMMON_TEXT[language].contactDetails;

// The couples' words stay as they wrote them; the line under each name is
// translated (texts.testimonials.details, same order).
const coupleQuotes = [
  {
    quote:
      'We had no experience, we started from zero, and by the end of the classes we had a beautiful dance for the day.',
    name: 'Marcel & Vera',
  },
  {
    quote:
      'We had very little time, with all the wedding preparations, but in just a few classes we managed to learn the dance!',
    name: 'Ajeng & Volkan',
  },
  {
    quote:
      'We chose to bring some tango into our first dance, and everything went just as we planned. Thank you.',
    name: 'Katrin & Robin',
  },
];
const testimonials = coupleQuotes.map((couple, index) => ({
  ...couple,
  quoteLanguage: 'en' as const,
  detail: texts.testimonials.details[index],
}));
---

<BaseLayout
  title={texts.meta.title}
  description={texts.meta.description}
  language={language}
  page="weddingDance"
>
  <Hero
    image={heroImage}
    imageAlt={texts.hero.imageAlt}
    eyebrow={texts.hero.eyebrow}
    heading={texts.hero.heading}
    description={texts.hero.description}
    primaryCta={{ href: '#wedding-contact', label: texts.hero.primaryButton }}
    secondaryCta={{ href: '#method', label: texts.hero.secondaryButton }}
    note={texts.hero.note}
  />

  <!-- ============ You don't need to be dancers ============ -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-intro" data-reveal>
        <span class="eyebrow">{texts.concerns.eyebrow}</span>
        <h2>{texts.concerns.heading}</h2>
        <p>{texts.concerns.intro}</p>
      </div>

      <div class="card-grid" data-reveal-group>
        {
          texts.concerns.items.map((concern) => (
            <div data-reveal>
              <Card title={concern.title} description={concern.description} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ The transformation ============ -->
  <section class="section">
    <div class="container">
      <div class="section-intro" data-reveal>
        <span class="eyebrow">{texts.transformation.eyebrow}</span>
        <h2>{texts.transformation.heading}</h2>
      </div>

      <div class="transform" data-reveal>
        <div class="transform__panel">
          <p class="transform__label">{texts.transformation.beforeLabel}</p>
          <ul>
            {texts.transformation.before.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="transform__arrow" aria-hidden="true">→</div>
        <div class="transform__panel transform__panel--after">
          <p class="transform__label">{texts.transformation.afterLabel}</p>
          <ul>
            {texts.transformation.after.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <p class="transform__statement" data-reveal>
        {texts.transformation.statement}
        <strong>{texts.transformation.statementStrong}</strong>
      </p>
    </div>
  </section>

  <!-- ============ Why tango ============ -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-intro" data-reveal>
        <span class="eyebrow">{texts.whyTango.eyebrow}</span>
        <h2>{texts.whyTango.heading}</h2>
      </div>

      <div class="why-grid" data-reveal-group>
        {
          texts.whyTango.reasons.map((reason) => (
            <div class="why-grid__item" data-reveal>
              <h3>{reason.title}</h3>
              <p>{reason.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ Meet the coaches ============ -->
  <section class="section">
    <div class="container">
      <div class="section-intro" data-reveal>
        <span class="eyebrow">{texts.coaches.eyebrow}</span>
        <h2>{texts.coaches.heading}</h2>
        <p>{texts.coaches.intro}</p>
      </div>

      <div class="coaches" data-reveal-group>
        <figure class="coaches__card" data-reveal>
          <Image
            src={joelPhoto}
            alt="Joel"
            widths={[300, 600]}
            sizes="(min-width: 720px) 45vw, 90vw"
            loading="lazy"
          />
          <figcaption>
            <h3>Joel</h3>
            <p>{texts.coaches.joel}</p>
          </figcaption>
        </figure>

        <figure class="coaches__card" data-reveal>
          <Image
            src={maddiePhoto}
            alt="Maddie"
            widths={[300, 600]}
            sizes="(min-width: 720px) 45vw, 90vw"
            loading="lazy"
          />
          <figcaption>
            <h3>Maddie</h3>
            <p>{texts.coaches.maddie}</p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ The method ============ -->
  <section id="method" class="section section--tint">
    <div class="container">
      <div class="section-intro" data-reveal>
        <span class="eyebrow">{texts.method.eyebrow}</span>
        <h2>{texts.method.heading}</h2>
      </div>

      <ol class="method" data-reveal-group>
        {
          texts.method.steps.map((step, i) => (
            <li class="method__step" data-reveal>
              <span class="method__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="method__body">
                <h3>{step.title}</h3>
                {step.meta && <p class="method__meta">{step.meta}</p>}
                <p class="method__desc">{step.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section">
    <div class="container faq">
      <div class="section-intro" data-reveal>
        <span class="eyebrow">{texts.faq.eyebrow}</span>
        <h2>{texts.faq.heading}</h2>
        <p>{texts.faq.intro}</p>
      </div>

      <div class="faq__list" data-reveal>
        {
          texts.faq.items.map((item) => (
            <details class="faq__item" name="wedding-faq">
              <summary>
                {item.question}
                <span class="faq__marker" aria-hidden="true"></span>
              </summary>
              <div class="faq__answer">
                <p>{item.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Testimonials
    language={language}
    eyebrow={texts.testimonials.eyebrow}
    heading={texts.testimonials.heading}
    testimonials={testimonials}
  />

  <CTA
    heading={texts.callToAction.heading}
    description={texts.callToAction.description}
    button={{ href: '#wedding-contact', label: texts.callToAction.button }}
  />

  <!-- ============ Contact ============ -->
  <section id="wedding-contact" class="section section--tint">
    <div class="container contact-block">
      <div class="contact-block__intro" data-reveal="left">
        <span class="eyebrow">{texts.contact.eyebrow}</span>
        <h2>{texts.contact.heading}</h2>
        <p>{texts.contact.intro}</p>

        <ul class="contact-block__details">
          <li>
            <strong>{contactDetails.email}</strong>
            <a href="mailto:info@tangomj.nl">info@tangomj.nl</a>
          </li>
          <li>
            <strong>{contactDetails.whatsapp}</strong>
            <a
              href="https://wa.me/31621710803"
              target="_blank"
              rel="noopener noreferrer">+31 6 21710803</a
            >
          </li>
          <li><strong>{contactDetails.area}</strong> {contactDetails.areaValue}</li>
        </ul>
      </div>

      <div class="contact-block__form surface-card" data-reveal="right">
        <ContactForm language={language} selectedTopic="Wedding dance" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Transformation ---------- */
  .transform {
    display: grid;
    gap: 20px;
    align-items: stretch;
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  @media (min-width: 760px) {
    .transform {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }
  }

  .transform__panel {
    background: var(--color-bg);
    border: var(--border-subtle);
    border-radius: var(--radius);
    padding: clamp(24px, 3vw, 34px);
  }

  .transform__panel--after {
    background: rgba(122, 31, 43, 0.05);
    border-color: rgba(122, 31, 43, 0.35);
  }

  .transform__label {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(44, 44, 42, 0.5);
  }

  .transform__panel--after .transform__label {
    color: var(--color-acento);
  }

  .transform__panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .transform__panel li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: rgba(44, 44, 42, 0.72);
  }

  .transform__panel li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1.5px solid rgba(7, 58, 124, 0.3);
  }

  .transform__panel--after li {
    color: rgba(44, 44, 42, 0.9);
    font-weight: 500;
  }

  .transform__panel--after li::before {
    border: none;
    background: var(--color-detalle);
  }

  .transform__arrow {
    text-align: center;
    font-size: 24px;
    color: var(--color-secundario);
    transform: rotate(90deg);
  }

  @media (min-width: 760px) {
    .transform__arrow {
      transform: none;
    }
  }

  .transform__statement {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
    font-size: clamp(18px, 2.4vw, 26px);
    line-height: 1.45;
    color: rgba(44, 44, 42, 0.6);
  }

  .transform__statement strong {
    display: block;
    margin-top: 4px;
    color: var(--color-acento);
    font-weight: 600;
  }

  /* ---------- Why tango ---------- */
  .why-grid {
    display: grid;
    gap: var(--gap-md);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .why-grid__item {
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius);
    box-shadow: var(--shadow-rest);
    padding: clamp(24px, 3vw, 34px);
    transition:
      transform 0.5s var(--ease-premium),
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  .why-grid__item:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--color-principal) 40%, transparent);
    box-shadow: var(--shadow-hover);
  }

  .why-grid__item h3 {
    margin: 0 0 8px;
    color: var(--color-principal);
    font-weight: var(--weight-heading);
    font-size: clamp(18px, 1.8vw, 21px);
  }

  .why-grid__item p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.65;
    color: rgba(44, 44, 42, 0.68);
  }

  /* ---------- Coaches ---------- */
  .coaches {
    display: grid;
    gap: var(--gap-md);
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .coaches {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .coaches__card {
    margin: 0;
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-rest);
  }

  .coaches__card :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    background: var(--color-bg);
  }

  .coaches__card figcaption {
    padding: clamp(20px, 2.6vw, 28px);
  }

  .coaches__card h3 {
    margin: 0 0 8px;
    color: var(--color-principal);
    font-weight: var(--weight-heading);
    font-size: clamp(18px, 1.8vw, 21px);
  }

  .coaches__card p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.65;
    color: rgba(44, 44, 42, 0.68);
  }

  /* ---------- Method ---------- */
  .method {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }

  @media (min-width: 900px) {
    .method {
      grid-template-columns: repeat(5, 1fr);
      gap: 18px;
    }
  }

  .method__step {
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius);
    box-shadow: var(--shadow-rest);
    padding: clamp(22px, 2.6vw, 28px);
    display: flex;
    gap: 14px;
  }

  @media (min-width: 900px) {
    .method__step {
      flex-direction: column;
      gap: 10px;
    }
  }

  .method__num {
    flex: none;
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 300;
    line-height: 1;
    color: var(--color-principal);
    opacity: 0.25;
  }

  .method__body h3 {
    margin: 0 0 8px;
    font-weight: var(--weight-heading);
    font-size: 17px;
    color: var(--color-principal);
  }

  .method__meta {
    margin: 0 0 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-secundario);
  }

  .method__desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(44, 44, 42, 0.66);
  }

  /* ---------- FAQ ---------- */
  .faq {
    max-width: 800px;
  }

  .faq__list {
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius);
    box-shadow: var(--shadow-rest);
    overflow: hidden;
  }

  .faq__item {
    border-bottom: var(--border-subtle);
  }

  .faq__item:last-child {
    border-bottom: none;
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(18px, 2.4vw, 24px) clamp(20px, 3vw, 30px);
    font-size: clamp(15.5px, 1.6vw, 17px);
    font-weight: 500;
    color: var(--color-principal);
    cursor: pointer;
    list-style: none;
    transition: background-color 0.3s ease;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary:hover {
    background: rgba(7, 58, 124, 0.03);
  }

  .faq__marker {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
  }

  .faq__marker::before,
  .faq__marker::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--color-principal);
    transition: transform 0.35s var(--ease-premium), background-color 0.3s ease;
  }

  .faq__marker::before {
    width: 12px;
    height: 1.5px;
    transform: translate(-50%, -50%);
  }

  .faq__marker::after {
    width: 1.5px;
    height: 12px;
    transform: translate(-50%, -50%);
  }

  .faq__item[open] .faq__marker::after {
    transform: translate(-50%, -50%) rotate(90deg) scale(0);
  }

  .faq__item[open] .faq__marker::before {
    background: var(--color-acento);
  }

  .faq__answer p {
    margin: 0;
    padding: 0 clamp(20px, 3vw, 30px) clamp(18px, 2.4vw, 24px);
    font-size: 14.5px;
    line-height: 1.7;
    color: rgba(44, 44, 42, 0.7);
    max-width: 58ch;
  }

  /* ---------- Contact block (shared with home) ---------- */
  .contact-block {
    display: grid;
    gap: clamp(32px, 6vw, 64px);
  }

  @media (min-width: 860px) {
    .contact-block {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .contact-block__details {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
    color: rgba(44, 44, 42, 0.8);
  }

  @media (prefers-reduced-motion: reduce) {
    .why-grid__item:hover {
      transform: none;
    }
    .faq__marker::before,
    .faq__marker::after {
      transition: none;
    }
  }
</style>
