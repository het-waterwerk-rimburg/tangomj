---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title: string;
  description: string;
  /** Path-relative OG image, resolved against the site origin. */
  image?: string;
  /** Use `title` exactly as given, without appending " · SITE_NAME" (for the home page, which already spells out the brand). */
  fullTitle?: boolean;
}

// Long form: <title> suffix and og:site_name (SEO). Short form: the visible
// brand text in the header/footer (logo alt, aria-labels, copyright line).
const SITE_NAME = 'TangoMJ - Argentine Tango Landgraaf';
const BRAND_NAME = 'TangoMJ';

const {
  title,
  description,
  image = '/og-default.png',
  fullTitle = false,
} = Astro.props;

const pageTitle =
  fullTitle || title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;

// Canonical + absolute OG URLs. Astro.site comes from `site` in astro.config.mjs.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

// Organization data — sourced from the real, published details in
// Footer.astro (social links) and Legal Notice (registered company info).
// Kept sitewide since it describes the business, not a single page.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Tango MJ',
  url: new URL('/', Astro.site).toString(),
  logo: ogImageURL.toString(),
  image: ogImageURL.toString(),
  email: 'info@tangomj.nl',
  telephone: '+31 6 21710803',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Kapelweien 2A',
    postalCode: '6374 LX',
    addressLocality: 'Landgraaf',
    addressCountry: 'NL',
  },
  sameAs: [
    'https://www.facebook.com/tangomj.experience/',
    'https://www.instagram.com/tango_mj/',
    'https://www.tiktok.com/@tango.mj',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Analytics 4: production builds only, and only after Analytics consent -->
    <GoogleAnalytics />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="2493" />
    <meta property="og:image:height" content="832" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Fonts: Inter, self-hosted via the Astro Fonts API (see astro.config.mjs) -->
    <Font cssVariable="--font-inter" preload />

    <!-- Organization structured data (sitewide) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <!-- Early in the DOM so keyboard users reach the consent choice first -->
    <CookieConsent />
    <Header siteName={BRAND_NAME} />
    <main id="main">
      <slot />
    </main>
    <Footer siteName={BRAND_NAME} />
    <WhatsAppButton />

    <script>
      // Reveal elements once as they enter the viewport (guide §8.3).
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
