---
// English (default language, at the root) — one page per article in src/content/blog/en/; the page itself is in src/views/BlogPostPage.astro.
import BlogPostPage from '../../views/BlogPostPage.astro';
import { getPostRoutes, type BlogPost } from '../../i18n/blog';

export async function getStaticPaths() {
  return getPostRoutes('en');
}

const { post } = Astro.props as { post: BlogPost };
---

<BlogPostPage language="en" post={post} />
