---
/**
 * 404 page. A static site has a single 404 page, so it is in English (the
 * default language) and also points Dutch and German visitors to their home page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { pagePath } from '../i18n/languages';
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist. Head back to the TangoMJ home page."
  language="en"
>
  <section class="section not-found">
    <div class="container not-found__inner">
      <img
        src="/404.jpeg"
        width="1600"
        height="1600"
        alt="Illustration of tango dancers, for a page that has wandered off the dance floor"
        class="not-found__image"
        data-reveal="zoom"
      />

      <div data-reveal-group>
        <span class="eyebrow" data-reveal>404</span>
        <h1 data-reveal>Oops! This page doesn't exist.</h1>
        <p data-reveal>
          The step you were looking for isn't on this floor. It may have been
          moved, renamed, or never existed at all.
        </p>
        <div data-reveal>
          <Button href={pagePath('home', 'en')} variant="secondary">Back to home</Button>
        </div>
        <p class="not-found__languages" data-reveal>
          <a href={pagePath('home', 'nl')} lang="nl" hreflang="nl">Naar de Nederlandse homepage</a>
          <span aria-hidden="true">·</span>
          <a href={pagePath('home', 'de')} lang="de" hreflang="de">Zur deutschen Startseite</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    min-height: 60vh;
  }

  .not-found__inner {
    max-width: 520px;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .not-found__image {
    width: 100%;
    max-width: 220px;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow-rest);
    margin-bottom: 28px;
  }

  .not-found h1 {
    margin-bottom: 12px;
  }

  .not-found p {
    color: rgba(44, 44, 42, 0.75);
    margin-bottom: 32px;
  }

  .not-found__languages {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 10px;
    margin: 20px 0 0;
    font-size: 14px;
  }

  .not-found__languages a {
    color: var(--color-principal);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .not-found__languages a:hover {
    color: var(--color-acento);
  }
</style>
